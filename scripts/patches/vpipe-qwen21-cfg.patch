@@ -441,3 +441,32 @@ TEST(qwen_image_21_layout, the_schedule_comes_from_the_checkpoint)
       GIS::qi21_checkpoint_schedule(bad.string()).sample_sigmas.empty());
   fs::remove_all(base);
 }
+
+TEST(qwen_image21_layout, cfg_branches_keep_distinct_text_indices_and_prefixes)
+{
+  auto positive = make_slots_({3, 5}, {4, 4});
+  auto negative = make_slots_({3, 5}, {4, 4});
+  positive.insert(positive.end(), 8, 0);
+  negative.insert(negative.end(), 1, 0);
+  auto with_target = [](std::vector<std::uint8_t> slots) {
+    slots.insert(slots.end(), 4, 1);
+    return slots;
+  };
+  const std::vector<ImgBlock> blocks = {{1, 4, 4}, {1, 4, 4}, {1, 4, 4}};
+  Layout pos, neg;
+  std::string err;
+  Q21L_REQUIRE(build_layout(with_target(positive), {}, blocks, &pos, &err));
+  Q21L_REQUIRE(build_layout(with_target(negative), {}, blocks, &neg, &err));
+  EXPECT_TRUE(pos.prefix_len == neg.prefix_len + 7);
+  EXPECT_TRUE(pos.image_len == neg.image_len);
+  EXPECT_TRUE(pos.target_len == neg.target_len);
+  for (const auto row : neg.text_src) {
+    EXPECT_TRUE(row >= 0 && row < (int)negative.size());
+  }
+  EXPECT_TRUE(pos.text_src.back() >= (int)negative.size());
+  for (int i = 0; i < neg.target_len; ++i) {
+    const int p = pos.prefix_len + i, n = neg.prefix_len + i;
+    EXPECT_TRUE(pos.pos_h[p] == neg.pos_h[n]);
+    EXPECT_TRUE(pos.pos_w[p] == neg.pos_w[n]);
+  }
+}
