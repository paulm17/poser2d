+
+TEST(runtime_lora, split_fused_gate_up_keeps_shared_a_and_output_row_order)
+{
+  Session sess;
+  auto* mc = sess.metal_compute();
+  ASSERT_TRUE(mc != nullptr);
+  if (mc == nullptr) { return; }
+  std::error_code ec; fs::create_directories(scratch(), ec);
+  const fs::path p = scratch() / "split-gate-up.safetensors";
+  const int R = 2, K = 4, G = 3, U = 2;
+  ASSERT_TRUE(write_st(p, {
+      {"diffusion_model.img_mlp.gate_up.lora_A.weight", {R, K}, ramp(R*K, 1, 1)},
+      {"diffusion_model.img_mlp.gate_up.lora_B.weight", {G+U, R}, ramp((G+U)*R, 10, 1)},
+  }));
+  std::string err; auto ad = genai::lora::Adapter::open(p.string(), mc, &err);
+  ASSERT_TRUE(ad != nullptr); if (!ad) { return; }
+  genai::lora::Factors gate, up;
+  ASSERT_TRUE(ad->bind_split("img_mlp.gate_up", G, U, K, &gate, &up));
+  EXPECT_TRUE(ad->modules() == 1); EXPECT_TRUE(ad->skipped() == 0);
+  EXPECT_TRUE(gate.rank == R); EXPECT_TRUE(up.rank == R);
+  EXPECT_TRUE(gate.a.contents() == up.a.contents());
+  for (int row = 0; row < G+U; ++row) {
+    const auto& f = row < G ? gate : up;
+    const int local = row < G ? row : row-G;
+    for (int r = 0; r < R; ++r) {
+      EXPECT_TRUE(bf16_at(f.b, (std::size_t)local*R+r) == 10.0f+row*R+r);
+    }
+  }
+  // Malformed fused shapes are refused rather than partly applied.
+  genai::lora::Factors bad_g, bad_u;
+  EXPECT_FALSE(ad->bind_split("img_mlp.gate_up", G, U+1, K, &bad_g, &bad_u));
+  EXPECT_TRUE(bad_g.empty()); EXPECT_TRUE(bad_u.empty());
+}
