   return true;
 }
 
+bool
+Adapter::bind_split(const std::string& module, int first_n, int second_n,
+                    int k, Factors* first, Factors* second)
+{
+  if (first == nullptr || second == nullptr || first == second ||
+      first_n <= 0 || second_n <= 0 || k <= 0) { return false; }
+  *first = Factors{}; *second = Factors{};
+  Factors fused;
+  if (!bind(module, first_n + second_n, k, &fused)) { return false; }
+  const std::size_t row_bytes = (std::size_t)fused.rank * 2;
+  first->rank = second->rank = fused.rank;
+  first->a = fused.a.subview(0, fused.a.byte_size());
+  second->a = fused.a.subview(0, fused.a.byte_size());
+  first->b = fused.b.subview(0, (std::size_t)first_n * row_bytes);
+  second->b = fused.b.subview((std::size_t)first_n * row_bytes,
+                            (std::size_t)second_n * row_bytes);
+  return !first->empty() && !second->empty();
+}
